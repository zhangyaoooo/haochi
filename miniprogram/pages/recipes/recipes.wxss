/* 菜谱列表 — 温暖家常 */

.search-bar input {
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  background: #fffaf5;
  border: 2rpx solid var(--color-border);
  border-radius: 20rpx;
  color: var(--color-text);
}

.search-bar input:focus {
  border-color: var(--color-primary);
}

/* 分类横滚 */
.category-scroll {
  white-space: nowrap;
  padding: 16rpx 0;
}

.category-tag {
  display: inline-block;
  padding: 14rpx 36rpx;
  margin-right: 16rpx;
  background: #fffaf5;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #9b8579;
  box-shadow: 0 2rpx 8rpx rgba(140, 90, 50, 0.06);
}

.category-tag.active {
  background: linear-gradient(135deg, #c7693e, #b85a32);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(199, 105, 62, 0.3);
}

/* 双列网格 */
.recipe-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grid-item {
  width: calc(50% - 8rpx);
}

/* 加载提示 */
.end-tip {
  text-align: center;
  padding: 48rpx 0;
  color: #c8b8a8;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #c7693e, #b85a32);
  color: #fff;
  font-size: 52rpx;
  font-weight: 300;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(199, 105, 62, 0.35);
  z-index: 10;
}
