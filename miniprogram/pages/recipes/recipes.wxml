<view class="container">
  <view class="search-bar mb-2">
    <input placeholder="🔍 搜索菜谱..." bindconfirm="onSearch" confirm-type="search" />
  </view>

  <scroll-view class="category-scroll" scroll-x>
    <view
      class="category-tag {{activeCategory === item ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      data-category="{{item}}"
      bindtap="onCategoryTap"
    >{{item}}</view>
  </scroll-view>

  <view class="recipe-grid mt-2">
    <view class="grid-item" wx:for="{{recipes}}" wx:key="_id">
      <recipe-card recipe="{{item}}" bind:tap="onRecipeTap" />
    </view>
  </view>
  <view wx:if="{{!hasMore && recipes.length > 0}}" class="end-tip">
    — 已经到底了 —
  </view>
  <view wx:if="{{recipes.length === 0}}" class="empty-tip">
    <view class="empty-tip-icon">📖</view>
    <view class="text-lg">还没有菜谱</view>
    <view class="text-sm mt-2">点击右下角 ＋ 添加第一道菜吧</view>
  </view>

  <view class="fab" bindtap="onAddRecipe">＋</view>
</view>
