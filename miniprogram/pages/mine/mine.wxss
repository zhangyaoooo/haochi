/* 我的页 — 温暖家常 */

.tab-bar {
  display: flex;
  background: #fffaf5;
  border-radius: 20rpx;
  padding: 6rpx;
  gap: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #9b8579;
  border-radius: 16rpx;
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, #c7693e, #b85a32);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(199, 105, 62, 0.25);
}

.order-card {
  background: #fffaf5;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(140, 90, 50, 0.06);
  border-left: 4rpx solid #f0e4d8;
}

.order-name-mine {
  font-size: 30rpx;
  font-weight: 700;
  color: #4a3128;
}

.order-meta {
  font-size: 24rpx;
  color: #9b8579;
  margin-top: 6rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.btn-outline {
  flex: 1;
  background: #fffaf5;
  border: 2rpx solid #e8d5c4;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  text-align: center;
  color: #9b8579;
  font-weight: 500;
}

.btn-outline:last-child {
  color: #c85a4a;
  border-color: #f0d0c8;
}

.btn-small {
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 14rpx;
  font-weight: 500;
}

.btn-cancel {
  background: #fffaf5;
  color: #9b8579;
  border: 2rpx solid #e8d5c4;
}
