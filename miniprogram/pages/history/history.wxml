<view class="container">
  <view class="text-xl mb-2">📋 历史记录</view>

  <block wx:for="{{orders}}" wx:key="_id">
    <view class="history-item">
      <view class="flex justify-between items-center">
        <view>
          <view class="history-name">{{item.recipeName}}</view>
          <view class="history-meta">{{item.date}} · {{item.orderedByName}} 点 · {{item.claimedByName}} 做</view>
        </view>
        <view wx:if="{{item.rating}}" class="history-rating">{{item.rating}}⭐</view>
        <view wx:else class="order-meta">未评价</view>
      </view>
      <view wx:if="{{item.feedback}}" class="feedback">"{{item.feedback}}"</view>
    </view>
  </block>

  <view wx:if="{{orders.length === 0 && !loading}}" class="empty-tip">
    📜 还没有已完成的历史记录
  </view>
</view>
